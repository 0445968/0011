# Server-only configuration. Never prefix the privileged key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional canonical origin, e.g. https://bivi.pro. Omit for same-origin local/preview testing.
INQUIRY_APP_URL=

# Public/publishable project API key, used server-side for staff sessions and RLS reads.
SUPABASE_ANON_KEY=
