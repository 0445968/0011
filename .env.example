# Server-only configuration. Never prefix the privileged key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public website origin. This remains the canonical origin for project inquiries.
INQUIRY_APP_URL=https://bivi.pro

# Public account/workspace origins. These are not secrets.
NEXT_PUBLIC_BIVI_APP_URL=https://app.bivi.pro
NEXT_PUBLIC_BIVI_STAFF_URL=https://staff.bivi.pro

# Public/publishable project API key, used server-side for staff sessions and RLS reads.
SUPABASE_ANON_KEY=
